<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>E_POS.LocalPrintAgent</AssemblyName>
    <Version>1.1.0</Version>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Description>E_POS Local Print Agent — Windows service for ESC/POS receipt printing and cash-drawer pulse.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Production.json.example" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
